[Unit]
Description=Podman  dashy-app.service
BindsTo=dashy.service
After=dashy.service

[Service]
Environment=PODMAN_SYSTEMD_UNIT=%n
EnvironmentFile=%E/state/environment
WorkingDirectory=%E/state
Restart=always
TimeoutStopSec=70
ExecStartPre=/bin/mkdir -p tmp
ExecStartPre=/bin/rm -f %t/dashy-app.pid %t/dashy-app.ctr-id
ExecStart=/usr/bin/podman run --conmon-pidfile %t/dashy-app.pid \
    --cidfile %t/dashy-app.ctr-id --cgroups=no-conmon \
    --pod-id-file %t/dashy.pod-id --replace -d --name  dashy-app \
    --volume dashy-app:/app/user-data/conf.yml \
    --env-file=%E/state/app.env \
    ${DASHY_IMAGE}
ExecStop=/usr/bin/podman stop --ignore --cidfile %t/dashy-app.ctr-id -t 10
ExecReload=/usr/bin/podman kill -s HUP dashy-app
SyslogIdentifier=%u
ExecStopPost=/usr/bin/podman rm --ignore -f --cidfile %t/dashy-app.ctr-id
PIDFile=%t/dashy-app.pid
Type=forking

[Install]
WantedBy=default.target
